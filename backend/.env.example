# Copy to backend/.env and fill in. Never commit the real .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chubbstub
DB_USER=bnd_readonly
DB_PASSWORD=change-me-to-a-random-value
AMOUNT_CURRENCY_LABEL=USD

# Demo login — generate with: python -m app.create_demo_user --email demo@example.com
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3010
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Customer accounts (optional). The app-owned "app" schema is written with this role.
# See README "Customer accounts". Admin login works without these.
APP_DB_USER=
APP_DB_PASSWORD=
# Customer number must equal <last 3 letters of last name><SSN last 4>. Confirm with the client.
IDENTITY_SOURCE_TABLE=ar_invoicehistoryheader
IDENTITY_CUSTOMERNO_COLUMN=customerno
IDENTITY_NAME_COLUMN=billtoname
# console = development (codes go to the server log). Use smtp in production.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
PHONE_DEFAULT_COUNTRY_CODE=1
# Only true behind the Next.js proxy, which sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# TEST MODE ONLY: no email is sent and the code is always 123456. Never enable in production.
OTP_TEST_MODE=false
